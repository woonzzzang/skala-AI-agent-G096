digraph IncidentAgent {
  graph [
    rankdir=TB, bgcolor="white", pad="0.30", nodesep="0.48", ranksep="0.55",
    splines=polyline, fontname="Apple SD Gothic Neo", labelloc=t,
    label="운영 장애 대응 Agent Graph", fontsize=21, fontcolor="#174A76"
  ];
  node [
    shape=box, style="rounded,filled", fillcolor="#E7F2FF",
    color="#AFCFEA", penwidth=1.4, fontcolor="#1268AA",
    fontname="Apple SD Gothic Neo", fontsize=13, margin="0.21,0.12"
  ];
  edge [
    color="#8292A1", fontcolor="#44627B", penwidth=1.2,
    arrowsize=0.7, fontname="Apple SD Gothic Neo", fontsize=10
  ];

  question [label="사용자 질문"];
  route [label="route\n일반 대화 / 장애 질문 분기"];
  chat [label="chat_answer → 종료"];
  target [label="resolve_target\n등록 시스템 후보 확인"];
  clarify [label="clarify_target\ninterrupt()로 대상 질문\nSQLite에 중단 상태 저장"];
  plan [label="plan\n확정 시스템별 태스크 작성"];
  gate [label="gate\n허용되지 않은 분석 태스크 제거"];
  research [label="research\n1차: Monitoring Tool\n2차: Runbook Resource"];
  replan [label="replan_check\n1차: Runbook 검색·태스크 추가\n2차: 조사 루프 종료"];
  analysis [label="analysis\n필요한 분석 태스크가 있을 때만 처리"];
  write [label="write\n근거를 바탕으로 보고서 초안 작성"];
  validate [label="validate\n코드 검사 + LLM Judge"];
  finalize [label="finalize\n합격: 보고서 / 3회 미통과: 확인된 사실만"];
  done [label="최종 응답", fillcolor="#DDF5ED", color="#A4D4C0", fontcolor="#24775B"];

  question -> route;
  {rank=same; chat; target;}
  route -> chat [label="일반 대화"];
  route -> target [label="장애 질문"];
  chat -> done [constraint=false];
  target -> clarify [label="missing / unknown / ambiguous"];
  clarify -> target [label="같은 graph_thread_id + Command(resume=답변)", constraint=false,
                     color="#4C9EDD", fontcolor="#287DB8"];
  target -> plan [label="resolved"];
  plan -> gate;
  gate -> research;
  research -> replan;
  replan -> research [label="1차에 문서 선택됨: 같은 노드 재실행", constraint=false,
                       color="#4C9EDD", fontcolor="#287DB8"];
  replan -> analysis [label="문서 없음 / 2차 완료"];
  analysis -> write;
  write -> validate;
  validate -> write [label="불합격, 3회 미만", constraint=false,
                     color="#4C9EDD", fontcolor="#287DB8"];
  validate -> finalize [label="합격 / 3회 도달"];
  finalize -> done;
}
